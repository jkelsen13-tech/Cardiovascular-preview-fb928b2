  "courseTerminologyNotes": {
    "M08.01": {
      "pages": "228,230–231,234–235",
      "note": "Standard 25 mm/s and 10 mm/mV values are textual teaching relationships. No calibrated grid or standardization pulse is displayed. Approved narration corrects the source p231 fixed 0.8-second-cycle shorthand."
    },
    "M08.02": {
      "pages": "271–275,415",
      "note": "P-wave and PR definitions are source-linked explanations. PR is not solely AV-nodal delay; no lead-II recording or actual interval is displayed/measured."
    },
    "M08.03": {
      "pages": "276–278,420",
      "note": "The J point is QRS end/ST start. No live caliper, QRS-width measurement or source strip is presented. Wide QRS is not assigned a single origin."
    },
    "M08.04": {
      "pages": "273,276,279–280",
      "note": "Electrical events and mechanical effects remain distinct. ST changes and U-wave explanations do not establish a clinical diagnosis."
    },
    "M08.05": {
      "pages": "281,428",
      "note": "The half-RR rule is qualified as a rough screen. No QT endpoint is measured and no QTc formula/result is generated."
    },
    "M08.06": {
      "pages": "376,392,394,409,415,420,428",
      "note": "Six-step observation method is a study checklist, not a scored strip interpretation or a generated rhythm classification."
    },
    "M08.07": {
      "pages": "376",
      "note": "The cited course page supports regularity comparison; ectopic/premature/escape distinctions follow the approved adapted narration. No calipers, ectopic waveform or pause strip are displayed."
    },
    "M08.08": {
      "pages": "392,394,399–402",
      "note": "Three large boxes equal fifteen small boxes and 100 bpm; eighteen small boxes produce about 83 bpm. The source p400 conflicting counts are not treated as measurements of the same interval. All examples are arithmetic, not measured image findings."
    },
    "M08.09": {
      "pages": "376,392,409,415,420,428",
      "note": "Conditional practice checkpoint. This lesson displays no strip or marking/caliper tool and records no answers. Existing ECG practice remains separately learner controlled; unseen numbered course figures are not recreated."
    }
  },
